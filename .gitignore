# Project Astra - Git Ignore
# Protect sensitive data, media assets, and environment files

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Secrets & Environment
.env
.env.local
.env.*.local
secrets/
*.pem
*.key

# Data & Media (CRITICAL: Never commit generated assets or state)
data/state_log.json
data/sessions/*.json
media/staging/
media/exports/
media/error_logs/
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.mp4
*.mov

# Logs
*.log
logs/

# Playwright
playwright-report/
test-results/

# pytest
.pytest_cache/
.pytest_cache/**

# macOS
.DS_Store

# GitHub Artifacts (local testing)
*.zip
*.tar.gz

# Node (if any frontend tooling)
node_modules/
